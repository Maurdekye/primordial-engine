# command (cwd = crate, under heavy.sh): CARGO_TARGET_DIR=<tmp>/t cargo rustc --release --lib --target wasm32-unknown-unknown --offline -q
## src/lib.rs
#![no_std]
#[panic_handler]
fn panic(_: &core::panic::PanicInfo) -> ! { loop {} }
static ENV: &str = match option_env!("PE_ASYM_UNSET") { Some(s) => s, None => "" };
static DIR: &str = env!("CARGO_MANIFEST_DIR");
static FILE: &[u8] = include_bytes!("<work>/tmp/asym-depinfo/outside.bin");
#[path = "../sub/far.rs"]
mod far;
#[unsafe(no_mangle)]
pub extern "C" fn probe(i: usize) -> u32 { ENV.len() as u32 + DIR.len() as u32 + FILE.get(i).copied().unwrap_or(0) as u32 + far::k() }
## sub/far.rs (outside src/)
pub fn k() -> u32 { 7 }
