#!/bin/sh
# The landing gate as a git hook: refuses any update of main whose new commit fails scripts/gate.sh.
#
# Install it once per clone, for every worktree: bash scripts/install_gate_hook.sh
# That writes a small trampoline into git's own folder, outside every working tree, and points
# core.hooksPath at it. The trampoline runs this file as committed at main's old tip, so the hook, like the
# rest of the gate's code, comes from the base: a landing can't change or delete the hook that judges it.
# Git runs reference-transaction for every ref update in every worktree. This hook acts only when
# refs/heads/main moves or is deleted, in the "prepared" state, where a non-zero exit aborts the update:
# a merge, commit, reset, update-ref, or a fetch or push into this repository alike. It runs scripts/gate.sh as
# committed at the old tip, with the old tip as the base (when main is created: the new commit's, over its
# whole history), and refuses the update if the gate fails or can't run. It refuses to delete main, and to move
# it when git gives an old value but main's tip can't be read. Every other update returns at once, and so does
# one that leaves main where it is (a reset to HEAD, merge --abort, stash, pack-refs): nothing lands.
# The old tip is main's tip as git holds it locked, not the old value in the hook's input: git gives zeros there
# for a forced update (update-ref without an old value, branch -f), which would read as main being created.
#   PE_GATE=off                      lets one command through unchecked, a deletion of main included, in an
#                                    emergency only; report it to the coordinator in the same turn
#   git config pe.gate.wrap '<cmd>'  runs the audit's cargo calls under <cmd>; never a build-slot wrapper, since
#                                    git holds main's lock meanwhile (the main clone has "nice -n 19")
#   git config pe.gate.tmpdir <dir>  puts the hook's and the gate's temporary files in <dir>, an absolute path to a
#                                    folder that exists (on Windows written S:/like/this), not TMPDIR's: the main
#                                    clone keeps them off C:
# Check a branch before merging it, so a refusal is rare: bash scripts/gate.sh --base main <branch>

if [ "$1" != prepared ]; then
  while read -r _; do :; done
  exit 0
fi
hit=
while read -r old new ref; do
  if [ "$ref" = refs/heads/main ]; then hit="$old $new"; fi
done
[ -n "$hit" ] || exit 0
set -- $hit
old=$1 new=$2
packed() {  # main's line in packed-refs: 0 there, 1 not there (no file included), 2 can't tell (grep failed)
  [ -e "$1/packed-refs" ] || return 1
  grep -q ' refs/heads/main$' "$1/packed-refs"
  case $? in 0) return 0 ;; 1) return 1 ;; *) return 2 ;; esac
}
tip=$(git rev-parse -q --verify refs/heads/main) || tip=   # main's tip before this update: git holds it locked
unreadable=
if [ -n "$tip" ]; then
  [ "$tip" != "$new" ] || exit 0               # main stays where it is: nothing lands, nothing to check
  case "$new" in *[!0]*) ;; *)                 # pack-refs (git gc) dropping main's loose file: see the trampoline
    common=$(git rev-parse --path-format=absolute --git-common-dir) && [ "$old" = "$tip" ] &&
      [ ! -e "$common/packed-refs.lock" ] && grep -qx "$tip refs/heads/main" "$common/packed-refs" 2> /dev/null &&
      exit 0 ;;
  esac
elif common=$(git rev-parse --path-format=absolute --git-common-dir) && [ ! -f "$common/refs/heads/main" ] &&
     { packed "$common"; [ $? = 1 ]; }; then     # a packed-refs file grep can't read counts as main being there
  case "$old$new" in *[!0]*) ;; *) exit 0 ;; esac   # main doesn't exist and isn't created: nothing happens
else
  unreadable=1                                 # main is there (a loose file or a packed line) but can't be read
fi
if [ "${PE_GATE:-on}" = off ]; then
  case "$new" in *[!0]*) what="main moves to $new" ;; *) what="main is deleted" ;; esac
  echo "gate (hook): PE_GATE=off, $what UNCHECKED: emergencies only; report it to the coordinator now" >&2
  exit 0
fi

refuse() {
  echo "gate (hook): REFUSED: main stays at $old. $*" >&2
  echo "gate (hook): if this was a merge in the main checkout, put it back with: git merge --abort" >&2
  echo "gate (hook):   (after a fast-forward or a reset: git reset --merge HEAD)" >&2
  exit 1
}
[ -z "$tip" ] || old=$tip                      # git gives zeros as the old value for a forced update or a deletion
drop="to drop the gate: git config --unset core.hooksPath"
[ -z "$unreadable" ] || refuse "main is there, but its tip can't be read ($drop)"
case "$new" in *[!0]*) ;; *) refuse "deleting main is refused while the gate is on ($drop)" ;; esac
[ -n "$tip" ] || case "$old" in *[!0]*) refuse "git gives main an old tip, but its tip can't be read" ;; esac
gtmp=$(git config --get pe.gate.tmpdir) &&
  case $gtmp in /*|[A-Za-z]:/*) [ -d "$gtmp" ] && export TMPDIR="$gtmp" TMP="$gtmp" TEMP="$gtmp" ;; esac
tmp=$(mktemp -d) || refuse "no temporary folder"
trap 'rm -rf "$tmp"' EXIT
case "$old" in *[!0]*) from=$old base="--base $old" ;; *) from=$new base=--full-history ;; esac
git show "$from:scripts/gate.sh" > "$tmp/gate.sh" 2> /dev/null ||
  refuse "$from has no scripts/gate.sh; the gate is required (to drop it: git config --unset core.hooksPath)"
wrap=$(git config --get pe.gate.wrap) || wrap=
short() { printf '%s' "$1" | cut -c1-10; }
echo "gate (hook): main $(short "$old")..$(short "$new"): running the landing gate, its code as of $(short "$from")" >&2
PE_GATE_WRAP=$wrap PE_GATE_CODE=$from bash "$tmp/gate.sh" $base "$new" >&2 || refuse "the gate did not pass (above)"
exit 0
