  {
    "name": "session_members",
    "description": "Membership as the driven peer sees it: members, evictions (cut seq, from frame), epoch, and vote counters.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Eviction": {
          "properties": {
            "cut_seq": {
              "description": "The member's entries above this seq were cut.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from_frame": {
              "description": "The first frame the member no longer counts for.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "cut_seq",
            "from_frame"
          ],
          "type": "object"
        },
        "MemberInfo": {
          "properties": {
            "evicted": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Eviction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "me": {
              "type": "boolean"
            },
            "member": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "member",
            "me"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "demotions": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "epoch": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "equivocations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lying_votes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "me": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/MemberInfo"
          },
          "type": "array"
        },
        "suspicions": {
          "description": "Members this peer presumed crashed and voted to remove.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "withdrawn_votes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "me",
        "epoch",
        "members",
        "suspicions",
        "demotions",
        "withdrawn_votes",
        "equivocations",
        "lying_votes"
      ],
      "type": "object"
    }
  },
  {
    "name": "session_sync_status",
    "description": "Sync health of the driven peer: frame, clock, confirmed frame, speculation and its limit, paused, check hashes matched/mismatched, rollback counters.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "FrameHash": {
          "properties": {
            "frame": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "hash": {
              "type": "string"
            }
          },
          "required": [
            "frame",
            "hash"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "caught_up": {
          "type": "boolean"
        },
        "checks_bad": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "checks_ok": {
          "description": "Check hashes that matched / differed from other members' (a mismatch means divergence).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "conf": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "latest_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_rollback_depth": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nonfinite": {
          "description": "Check frames at which some body held a non-finite value.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "now": {
          "description": "The peer's clock frame (its present).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "paused_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resim_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rollbacks": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "speculation": {
          "description": "now - conf: how far the peer speculates past the confirmed frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "description": "The speculation limit, in frames.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "frame",
        "now",
        "conf",
        "speculation",
        "window",
        "paused",
        "caught_up",
        "checks_ok",
        "checks_bad",
        "rollbacks",
        "max_rollback_depth",
        "resim_frames",
        "paused_frames",
        "nonfinite"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_get_object",
    "description": "One object's full state: global id, kind, position, rotation, velocities, exact-state hash and claim.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "object": {
          "description": "Object index (see world_get_state).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "object"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ClaimInfo": {
          "properties": {
            "member": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "object": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "until_frame": {
              "description": "The claim holds for frames below this one.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "object",
            "member",
            "until_frame"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "angular_velocity": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "global_id": {
          "description": "Session-wide id: the birth world in the high 32 bits.",
          "type": "string"
        },
        "kind": {
          "description": "box, sphere, capsule, ball or hand. Hands are kinematic and move only by `hand` interactions.",
          "type": "string"
        },
        "linear_velocity": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "object": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rotation": {
          "description": "Unit quaternion, [x, y, z, w].",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "state_hash": {
          "description": "Hash of the object's exact bit state.",
          "type": "string"
        }
      },
      "required": [
        "object",
        "global_id",
        "kind",
        "position",
        "rotation",
        "linear_velocity",
        "angular_velocity",
        "state_hash"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_get_state",
    "description": "The driven peer's world: frame, confirmed frame, state hash, a page of objects (position, velocity) and the claims in force.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "default": null,
          "description": "How many objects to list, 0..=256 (default 16).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": null,
          "description": "First object index to list (default 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ClaimInfo": {
          "properties": {
            "member": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "object": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "until_frame": {
              "description": "The claim holds for frames below this one.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "object",
            "member",
            "until_frame"
          ],
          "type": "object"
        },
        "ObjectSummary": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "linear_velocity": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "object": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "position": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "object",
            "kind",
            "position",
            "linear_velocity"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimInfo"
          },
          "type": "array"
        },
        "conf": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next_offset": {
          "description": "Pass as `offset` to read the next page.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "object_count": {
          "description": "Number of object slots, live or gone.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ObjectSummary"
          },
          "type": "array"
        },
        "state_hash": {
          "description": "Hash of the state after the newest simulated frame (absent before the first frame).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "frame",
        "conf",
        "object_count",
        "objects",
        "claims"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_hashes",
    "description": "State hashes after each frame in [from, to) (at most 600 frames), plus the canonical check hashes compared with other members.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "from": {
          "description": "First frame (inclusive).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "description": "Last frame (exclusive); at most 600 frames per call.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "FrameHash": {
          "properties": {
            "frame": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "hash": {
              "type": "string"
            }
          },
          "required": [
            "frame",
            "hash"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "checks": {
          "description": "Canonical full-state check hashes in the range (compared with other members' acks).",
          "items": {
            "$ref": "#/$defs/FrameHash"
          },
          "type": "array"
        },
        "conf": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames": {
          "description": "State hash after each simulated frame in the range.",
          "items": {
            "$ref": "#/$defs/FrameHash"
          },
          "type": "array"
        }
      },
      "required": [
        "conf",
        "frames",
        "checks"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_interaction_status",
    "description": "The current verdict on one of your interactions: pending, accepted, rejected (with reason) or void; `final` once its frame is confirmed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ticket": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ticket"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "InteractionState": {
          "oneOf": [
            {
              "enum": [
                "accepted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "const": "pending",
              "description": "Its frame has not been simulated yet.",
              "type": "string"
            },
            {
              "const": "void",
              "description": "Withdrawn: the entry broke a chain rule or was cut by an eviction.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "by_member": {
          "description": "For rejected because claimed: the claim holder.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entry": {
          "type": "string"
        },
        "final": {
          "description": "True once the stamp is confirmed: the state can no longer change. Before that a rollback\ncan still turn an acceptance into a rejection or the reverse.",
          "type": "boolean"
        },
        "reason": {
          "description": "For rejected: claimed, cooldown, gone, duplicate, portal_closed, no_proof, ...",
          "type": [
            "string",
            "null"
          ]
        },
        "stamp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/InteractionState"
        },
        "ticket": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "until_frame": {
          "description": "For claimed or cooldown rejections: when the obstacle ends.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "ticket",
        "entry",
        "stamp",
        "state",
        "final"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_propose_interaction",
    "description": "Author an interaction as the driven member, through the same path as a player's input: stamped with the present frame, ordered soonest-wins, rolled back when earlier entries arrive. touch/grab apply an impulse (grab renews its claim); hand moves a kinematic hand (ball-pit scenes). Returns a ticket; the outcome appears in world_step's `changed` and in world_interaction_status.",
    "inputSchema": {
      "$defs": {
        "InteractionAction": {
          "oneOf": [
            {
              "const": "touch",
              "description": "One impulse; claims the object once (other members' touches are refused while it holds).",
              "type": "string"
            },
            {
              "const": "grab",
              "description": "An impulse that is a held grab: renews the claim.",
              "type": "string"
            },
            {
              "const": "hand",
              "description": "Move one of the kinematic hands (ball-pit scenes) to `target_mm`.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/InteractionAction"
        },
        "active": {
          "default": null,
          "description": "hand: false parks the hand (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "impulse": {
          "default": null,
          "description": "touch and grab: impulse in N*s, three finite numbers, magnitude at most 100.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array",
            "null"
          ]
        },
        "object": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "target_mm": {
          "default": null,
          "description": "hand: target position in millimetres, each within +-100000.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "object",
        "action"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entry": {
          "description": "The signed entry's id.",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "seq": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stamp": {
          "description": "The canonical frame the entry is stamped with.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ticket": {
          "description": "Pass to world_interaction_status.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ticket",
        "entry",
        "stamp",
        "seq",
        "note"
      ],
      "type": "object"
    }
  },
  {
    "name": "world_step",
    "description": "Advance the session's virtual clock by `ms` milliseconds (1..=10000) or `frames` frames (1..=600). Every member ticks, the network delivers, the driven peer rolls back as needed. Reports the new frame and confirmed frame, rollbacks, your interactions whose state changed, and protocol events.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "frames": {
          "default": null,
          "description": "Advance by this many frames, 1..=600.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ms": {
          "default": null,
          "description": "Advance virtual time by this many milliseconds, 1..=10000. Give exactly one of ms, frames.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "InteractionState": {
          "oneOf": [
            {
              "enum": [
                "accepted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "const": "pending",
              "description": "Its frame has not been simulated yet.",
              "type": "string"
            },
            {
              "const": "void",
              "description": "Withdrawn: the entry broke a chain rule or was cut by an eviction.",
              "type": "string"
            }
          ]
        },
        "InteractionStatus": {
          "properties": {
            "by_member": {
              "description": "For rejected because claimed: the claim holder.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "entry": {
              "type": "string"
            },
            "final": {
              "description": "True once the stamp is confirmed: the state can no longer change. Before that a rollback\ncan still turn an acceptance into a rejection or the reverse.",
              "type": "boolean"
            },
            "reason": {
              "description": "For rejected: claimed, cooldown, gone, duplicate, portal_closed, no_proof, ...",
              "type": [
                "string",
                "null"
              ]
            },
            "stamp": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "$ref": "#/$defs/InteractionState"
            },
            "ticket": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "until_frame": {
              "description": "For claimed or cooldown rejections: when the obstacle ends.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "ticket",
            "entry",
            "stamp",
            "state",
            "final"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "changed": {
          "description": "This principal's interactions whose status changed during the step.",
          "items": {
            "$ref": "#/$defs/InteractionStatus"
          },
          "type": "array"
        },
        "conf": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "events": {
          "description": "Protocol events the driven peer logged (votes, evictions, check results), newest last, at\nmost 50.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "from_frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "paused": {
          "description": "The driven peer stopped at its speculation limit (frame - conf reached the window).",
          "type": "boolean"
        },
        "resim_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rollbacks": {
          "description": "Rollbacks and re-simulated frames on the driven peer during this step.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from_frame",
        "frame",
        "conf",
        "time_ms",
        "rollbacks",
        "resim_frames",
        "paused",
        "changed",
        "events"
      ],
      "type": "object"
    }
  }
]
