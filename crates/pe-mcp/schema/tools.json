[
  {
    "name": "scenario_check",
    "description": "Oracle check over the confirmed prefix: every live member's state hashes against the driven peer's, and the driven peer's against an offline replay of its final log. Reports the first divergence.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Divergence": {
          "properties": {
            "frame": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "member": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "frame",
            "member"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "crashed_members": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "first_divergence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Divergence"
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "description": "Frames 0..frames were compared: the lowest confirmed frame among live members.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "live_members": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "replay_equal": {
          "description": "The driven peer's hashes equal an offline replay of its final log.",
          "type": "boolean"
        },
        "replicas_equal": {
          "description": "Every live member's hashes equal the driven peer's for every compared frame.",
          "type": "boolean"
        }
      },
      "required": [
        "frames",
        "live_members",
        "crashed_members",
        "replicas_equal",
        "replay_equal"
      ],
      "type": "object"
    }
  },
  {
    "name": "scenario_fault",
    "description": "Inject a fault into the simulated session: crash a member (permanent), set a link's delay/jitter/loss, partition members into groups, or heal the partition.",
    "inputSchema": {
      "$defs": {
        "FaultKind": {
          "oneOf": [
            {
              "const": "crash",
              "description": "The member stops receiving, ticking and sending, for good.",
              "type": "string"
            },
            {
              "const": "link",
              "description": "Set the link between `from` and `to` (both directions unless `one_way`).",
              "type": "string"
            },
            {
              "const": "partition",
              "description": "Drop every datagram between members of different `groups`.",
              "type": "string"
            },
            {
              "const": "heal",
              "description": "Remove the partition (crashes are permanent; links stay as set).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "delay_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fault": {
          "$ref": "#/$defs/FaultKind"
        },
        "from": {
          "default": null,
          "description": "link: the two ends.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "groups": {
          "default": null,
          "description": "partition: disjoint groups covering some members; a member in no group is alone.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "jitter_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "loss_pct": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "member": {
          "default": null,
          "description": "crash: the member.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "one_way": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "to": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "fault"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "active": {
          "description": "Every fault in force.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "applied": {
          "type": "string"
        }
      },
      "required": [
        "applied",
        "active"
      ],
      "type": "object"
    }
  },
  {
    "name": "scenario_load",
    "description": "Start a fresh simulated session (replacing the current one, tickets included): members, the member you drive, scene, link delay/jitter/loss, background touches by the other members, speculation window, seed. Same parameters and seed give the same run.",
    "inputSchema": {
      "$defs": {
        "SceneChoice": {
          "oneOf": [
            {
              "const": "pile",
              "description": "A pile of boxes, spheres and capsules: size x size x 2 objects.",
              "type": "string"
            },
            {
              "const": "ballpit",
              "description": "A walled pit of small balls plus one kinematic hand per member; `size` = ball count.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "background_touches_per_s": {
          "default": null,
          "description": "Touches per second each other member makes on random objects, 0..=30 (default 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "delay_ms": {
          "default": null,
          "description": "One-way link delay, 0..=1000 ms (default 20).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "jitter_ms": {
          "default": null,
          "description": "Link jitter, 0..=500 ms (default 0).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "loss_pct": {
          "default": null,
          "description": "Datagram loss, 0..=50 percent (default 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "me": {
          "default": null,
          "description": "The member the agent drives (default 1).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "members": {
          "default": null,
          "description": "Session members, 2..=8 (default 4). Members are numbered 1..=members.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scene": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default pile."
        },
        "seed": {
          "default": null,
          "description": "Session seed (default fixed): the same parameters and seed give the same run.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "default": null,
          "description": "pile: side length 1..=8 (default 4); ballpit: balls 1..=500 (default 100).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "window": {
          "default": null,
          "description": "Speculation limit in frames, 30..=600 (default 120).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Scope": {
          "description": "What a token may do (design 17.2 scopes, narrowed to phase 2).",
          "oneOf": [
            {
              "const": "read",
              "description": "Read state, hashes, membership and sync status.",
              "type": "string"
            },
            {
              "const": "interact",
              "description": "Propose interactions as the driven peer's member.",
              "type": "string"
            },
            {
              "const": "control",
              "description": "Test-bench control: advance the clock, load scenarios, inject faults, run the oracle check.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "backend": {
          "description": "What implements the peer: \"session-sim\" (the phase-1 simulator) until P2-3 lands.",
          "type": "string"
        },
        "conf": {
          "description": "Every frame below this is confirmed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dt_ms": {
          "description": "Frame duration in milliseconds.",
          "format": "double",
          "type": "number"
        },
        "faulted": {
          "description": "Set once the session has stopped on an internal error.",
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "description": "The driven peer's simulated frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "me": {
          "description": "The member id the driven peer authors as.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "members": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "object_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "principal": {
          "description": "The principal this token maps to (design 17.1).",
          "type": "string"
        },
        "scenario": {
          "description": "Human-readable scenario label.",
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "type": "array"
        },
        "time_ms": {
          "description": "Virtual time since the session started, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "world": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scenario",
        "backend",
        "principal",
        "scopes",
        "me",
        "world",
        "members",
        "scene",
        "object_count",
        "dt_ms",
        "time_ms",
        "frame",
        "conf"
      ],
      "type": "object"
    }
  },
